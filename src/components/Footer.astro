---
const base = import.meta.env.BASE_URL;
---

<footer id="contact" class="border-t border-border">
  <div class="mx-auto max-w-[1120px] px-6 py-16 grid gap-12 md:grid-cols-2">
    <div>
      <h2 class="font-display text-2xl font-semibold mb-6">Get in touch</h2>
      <form method="post" action="https://formspree.io/f/mjkekgna" class="flex flex-col gap-4 max-w-md">
        <div class="flex flex-col gap-1">
          <label for="name" class="text-sm text-text-secondary">Name</label>
          <input type="text" name="name" id="name" required class="rounded-md border border-border bg-surface px-3 py-2 text-text focus:outline-none focus:border-accent" />
        </div>
        <div class="flex flex-col gap-1">
          <label for="email" class="text-sm text-text-secondary">Email</label>
          <input type="email" name="email" id="email" required class="rounded-md border border-border bg-surface px-3 py-2 text-text focus:outline-none focus:border-accent" />
        </div>
        <div class="flex flex-col gap-1">
          <label for="message" class="text-sm text-text-secondary">Message</label>
          <textarea name="message" id="message" rows="4" required class="rounded-md border border-border bg-surface px-3 py-2 text-text focus:outline-none focus:border-accent"></textarea>
        </div>
        <button type="submit" class="self-start rounded-md bg-accent px-5 py-2 font-medium text-bg hover:opacity-90 transition-opacity cursor-pointer">
          Send message
        </button>
      </form>
    </div>

    <div class="grid grid-cols-2 gap-8 content-start">
      <div>
        <h3 class="font-display text-sm font-semibold uppercase tracking-wide text-text-secondary mb-2">Location</h3>
        <p>Based in NYC</p>
      </div>
      <div>
        <h3 class="font-display text-sm font-semibold uppercase tracking-wide text-text-secondary mb-2">Phone</h3>
        <p>(917) 530-7763</p>
      </div>
      <div>
        <h3 class="font-display text-sm font-semibold uppercase tracking-wide text-text-secondary mb-2">Email</h3>
        <p><a href="mailto:zhimingx27@gmail.com" class="text-accent hover:underline">zhimingx27@gmail.com</a></p>
      </div>
      <div>
        <h3 class="font-display text-sm font-semibold uppercase tracking-wide text-text-secondary mb-2">Resume</h3>
        <p><a href={`${base}resume.pdf`} download="Zhi-Ming-Xu-Resume.pdf" class="text-accent hover:underline">Download PDF</a></p>
      </div>
    </div>
  </div>

  <div class="border-t border-border">
    <div class="mx-auto max-w-[1120px] px-6 py-6 flex flex-col sm:flex-row items-center justify-between gap-2 text-sm text-text-secondary">
      <p>&copy; 2026 Zhi Ming Xu</p>
      <div class="flex items-center gap-4">
        <a href="https://github.com/zmx27" target="_blank" rel="noreferrer" class="hover:text-accent transition-colors">GitHub</a>
        <a href="https://www.linkedin.com/in/zhi-ming-xu" target="_blank" rel="noreferrer" class="hover:text-accent transition-colors">LinkedIn</a>
      </div>
    </div>
  </div>
</footer>
