---
import type { Project } from "../data/projects";

interface Props {
  project: Project;
}

const { project } = Astro.props;
const base = import.meta.env.BASE_URL;
const categoryColor = project.category === "embedded" ? "bg-accent" : "bg-indicator";
---

<article
  data-category={project.category}
  data-video-preview
  class="group relative rounded-lg border border-border bg-surface overflow-hidden flex flex-col transition-all duration-300 hover:-translate-y-1 hover:bg-surface-raised hover:border-accent hover:shadow-[0_12px_32px_-12px_var(--accent)]"
>
  <!-- category accent bar -->
  <span class={`absolute left-0 top-0 bottom-0 w-1 ${categoryColor}`} aria-hidden="true"></span>

  <!-- corner brackets, revealed on hover -->
  <span class="pointer-events-none absolute inset-3 opacity-0 group-hover:opacity-100 transition-opacity duration-300" aria-hidden="true">
    <span class="absolute top-0 left-0 w-3 h-3 border-t-2 border-l-2 border-accent"></span>
    <span class="absolute top-0 right-0 w-3 h-3 border-t-2 border-r-2 border-accent"></span>
    <span class="absolute bottom-0 left-0 w-3 h-3 border-b-2 border-l-2 border-accent"></span>
    <span class="absolute bottom-0 right-0 w-3 h-3 border-b-2 border-r-2 border-accent"></span>
  </span>

  <a href={`${base}projects/${project.slug}/`} class="block aspect-video overflow-hidden bg-bg">
    <img
      src={`${base}${project.image.replace(/^\//, "")}`}
      alt={`${project.title} screenshot`}
      loading="lazy"
      class="w-full h-full object-cover"
    />
    {project.video && (
      <video
        class="hidden w-full h-full object-cover"
        data-src={`${base}${project.video.replace(/^\//, "")}`}
        poster={`${base}${project.image.replace(/^\//, "")}`}
        muted
        loop
        playsinline
        preload="none"
      ></video>
    )}
  </a>

  <div class="flex flex-col flex-1 p-6 gap-4">
    <h3 class="font-display text-xl font-semibold">
      <a href={`${base}projects/${project.slug}/`} class="hover:text-accent transition-colors">{project.title}</a>
    </h3>

    <ul class="flex flex-col gap-2 text-sm text-text-secondary list-disc pl-4">
      {project.bullets.slice(0, 2).map((bullet) => <li>{bullet}</li>)}
    </ul>

    <div class="flex flex-wrap gap-2 mt-auto pt-2">
      {project.tags.map((tag) => (
        <span class="font-mono text-xs rounded border border-border px-2 py-1 text-text-secondary">{tag}</span>
      ))}
    </div>

    <div class="flex gap-3 pt-2">
      <a
        href={`${base}projects/${project.slug}/`}
        class="rounded-md border border-accent px-4 py-2 text-sm font-medium text-accent hover:bg-accent hover:text-bg transition-colors"
      >
        Details
      </a>
      <a
        href={project.sourceUrl}
        target="_blank"
        rel="noreferrer"
        class="rounded-md border border-border px-4 py-2 text-sm font-medium text-text-secondary hover:border-accent hover:text-accent transition-colors"
      >
        Source
      </a>
    </div>
  </div>
</article>
