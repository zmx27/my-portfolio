---
const examples = [
  { note: "C3", divider: "3822", freq: "130.8 Hz" },
  { note: "C4", divider: "1911", freq: "261.6 Hz" },
  { note: "A4", divider: "1136", freq: "440.1 Hz" },
];
---

<div>
  <svg viewBox="0 0 820 260" class="w-full h-auto" role="img" aria-label="The 100MHz board clock is divided down to a 1MHz timing tick, which is then divided again to produce the note's pitch for the speaker and a fast scan rate for the display">
    <defs>
      <marker id="ccf-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
        <path d="M0,0 L10,5 L0,10 z" fill="var(--accent)"></path>
      </marker>
    </defs>

    <rect x="10" y="90" width="160" height="60" rx="8" fill="var(--surface-raised)" stroke="var(--border)"></rect>
    <text x="90" y="115" text-anchor="middle" class="font-sans" font-size="12" font-weight="600" fill="var(--text)">100MHz Board Clock</text>
    <text x="90" y="132" text-anchor="middle" class="font-mono" font-size="10" fill="var(--text-secondary)">the FPGA's own clock</text>

    <rect x="250" y="90" width="150" height="60" rx="8" fill="var(--surface-raised)" stroke="var(--accent)"></rect>
    <text x="325" y="112" text-anchor="middle" class="font-sans" font-size="12" font-weight="600" fill="var(--text)">Divide by 50</text>
    <text x="325" y="130" text-anchor="middle" class="font-mono" font-size="10" fill="var(--text-secondary)">1MHz timing tick</text>

    <rect x="480" y="20" width="190" height="55" rx="8" fill="var(--surface-raised)" stroke="var(--indicator)"></rect>
    <text x="575" y="41" text-anchor="middle" class="font-sans" font-size="12" font-weight="600" fill="var(--text)">Divide by the note's number</text>
    <text x="575" y="58" text-anchor="middle" class="font-mono" font-size="10" fill="var(--text-secondary)">sets the pitch</text>

    <rect x="480" y="165" width="190" height="55" rx="8" fill="var(--surface-raised)" stroke="var(--indicator)"></rect>
    <text x="575" y="186" text-anchor="middle" class="font-sans" font-size="12" font-weight="600" fill="var(--text)">Divide by 50 again</text>
    <text x="575" y="203" text-anchor="middle" class="font-mono" font-size="10" fill="var(--text-secondary)">10,000 ticks a second</text>

    <text x="695" y="52" text-anchor="start" class="font-mono" font-size="12" fill="var(--accent)">Speaker</text>
    <text x="695" y="197" text-anchor="start" class="font-mono" font-size="12" fill="var(--accent)">Display</text>

    <line x1="170" y1="120" x2="245" y2="120" stroke="var(--accent)" stroke-width="2" marker-end="url(#ccf-arrow)"></line>
    <path d="M400,110 C430,90 450,60 475,48" fill="none" stroke="var(--accent)" stroke-width="2" marker-end="url(#ccf-arrow)"></path>
    <path d="M400,130 C430,150 450,180 475,192" fill="none" stroke="var(--accent)" stroke-width="2" marker-end="url(#ccf-arrow)"></path>
    <line x1="670" y1="48" x2="690" y2="48" stroke="var(--indicator)" stroke-width="2" marker-end="url(#ccf-arrow)"></line>
    <line x1="670" y1="192" x2="690" y2="192" stroke="var(--indicator)" stroke-width="2" marker-end="url(#ccf-arrow)"></line>
  </svg>

  <div class="mt-6 pt-6 border-t border-border">
    <p class="font-mono text-sm text-text-secondary mb-4">frequency = 500,000 ÷ divider number</p>
    <div class="grid grid-cols-3 gap-3 max-w-md">
      <div class="font-mono text-xs text-text-secondary uppercase">Note</div>
      <div class="font-mono text-xs text-text-secondary uppercase">Divider</div>
      <div class="font-mono text-xs text-text-secondary uppercase">Frequency</div>
      {examples.map((ex) => (
        <>
          <div class="font-mono text-sm text-text">{ex.note}</div>
          <div class="font-mono text-sm text-text">{ex.divider}</div>
          <div class="font-mono text-sm text-accent">{ex.freq}</div>
        </>
      ))}
    </div>
  </div>
</div>
