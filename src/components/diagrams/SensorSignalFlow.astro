---
---

<svg viewBox="0 0 700 150" class="w-full h-auto" role="img" aria-label="Signal flow: DHT11 sensor to STM32 over single-wire bit-banging, then to LCD over I2C">
  <defs>
    <marker id="sensor-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M0,0 L10,5 L0,10 z" fill="var(--accent)"></path>
    </marker>
  </defs>

  <!-- node: DHT11 -->
  <rect x="10" y="45" width="140" height="60" rx="8" fill="var(--surface-raised)" stroke="var(--border)"></rect>
  <text x="80" y="70" text-anchor="middle" class="font-sans" font-size="13" font-weight="600" fill="var(--text)">DHT11</text>
  <text x="80" y="88" text-anchor="middle" class="font-mono" font-size="11" fill="var(--text-secondary)">temp / humidity</text>

  <!-- node: MCU -->
  <rect x="260" y="35" width="180" height="80" rx="8" fill="var(--surface-raised)" stroke="var(--accent)"></rect>
  <text x="350" y="65" text-anchor="middle" class="font-sans" font-size="13" font-weight="600" fill="var(--text)">STM32F401RE</text>
  <text x="350" y="83" text-anchor="middle" class="font-mono" font-size="11" fill="var(--text-secondary)">bare-metal HAL</text>
  <text x="350" y="100" text-anchor="middle" class="font-mono" font-size="11" fill="var(--text-secondary)">40-bit packet + checksum</text>

  <!-- node: LCD -->
  <rect x="550" y="45" width="140" height="60" rx="8" fill="var(--surface-raised)" stroke="var(--border)"></rect>
  <text x="620" y="70" text-anchor="middle" class="font-sans" font-size="13" font-weight="600" fill="var(--text)">16x2 LCD</text>
  <text x="620" y="88" text-anchor="middle" class="font-mono" font-size="11" fill="var(--text-secondary)">readings out</text>

  <!-- connecting lines, drawn on top of node boxes -->
  <line x1="150" y1="75" x2="260" y2="75" stroke="var(--accent)" stroke-width="2" marker-end="url(#sensor-arrow)"></line>
  <line x1="440" y1="75" x2="550" y2="75" stroke="var(--accent)" stroke-width="2" marker-end="url(#sensor-arrow)"></line>

  <!-- protocol labels, drawn last so they're never covered -->
  <text x="205" y="60" text-anchor="middle" class="font-mono" font-size="12" fill="var(--accent)">Single-wire</text>
  <text x="205" y="98" text-anchor="middle" class="font-mono" font-size="11" fill="var(--text-secondary)">1µs delay</text>
  <text x="495" y="60" text-anchor="middle" class="font-mono" font-size="12" fill="var(--accent)">I2C</text>
  <text x="495" y="98" text-anchor="middle" class="font-mono" font-size="11" fill="var(--text-secondary)">100kHz</text>
</svg>
