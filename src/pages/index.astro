---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import OscilloscopeTrace from "../components/OscilloscopeTrace.astro";
import TraceDivider from "../components/TraceDivider.astro";
import { projects } from "../data/projects";

const base = import.meta.env.BASE_URL;

const skillGroups = [
  {
    title: "Languages",
    items: ["Python", "C", "C++", "Java", "TypeScript", "SystemVerilog", "VHDL", "Verilog", "Bash", "MATLAB", "HTML", "CSS"],
  },
  {
    title: "Frameworks & Tools",
    items: [
      "Node.js", "Fastify", "LangGraph", "LangChain", "Java Spring", "Elasticsearch/OpenSearch",
      "Docker", "Kubernetes", "Git", "GitHub Actions", "Jenkins CI/CD", "CMake", "Xilinx Vivado", "STM32CubeIDE",
    ],
  },
  {
    title: "Hardware & Systems",
    items: [
      "STM32 (ARM Cortex-M)", "FPGA", "UART", "I2C", "SPI", "PWM", "Single-Wire", "GPIO",
      "Oscilloscope", "Digital Multimeter", "Function Generator", "Raspberry Pi", "Arduino UNO", "LTspice",
      "KiCad", "Altium Designer",
    ],
  },
];

const experience = [
  {
    org: "IBM Corporation",
    role: "Software Engineering Intern",
    dates: "May 2026 – Aug 2026",
    bullets: [
      "Engineered a stateful multi-agent AIOps diagnostic platform in TypeScript, Node.js, and LangGraph; orchestrated 3 parallel worker nodes via Model Context Protocol (MCP) servers to automate Kubernetes, OpenSearch, and Instana log correlation.",
      "Automated root-cause analysis across distributed Kubernetes clusters and data centers, replacing a 30-minute manual triage process with an automated 3-minute SLA.",
      "Constructed an automated test pipeline with offline mock data and scheduled LLM integration tests, containerizing the agent with Docker and Jenkins CI/CD.",
    ],
  },
  {
    org: "Columbia MobileX Lab",
    role: "Undergraduate Research Assistant",
    dates: "Jan 2026 – May 2026",
    bullets: [
      "Co-developed embedded C++ firmware on Arduino with PhD researchers for an AI voice anti-spoofing platform, implementing a deterministic state machine and 10s initialization sequence to achieve 100% signal stability.",
      "Configured an embedded Linux audio node on Raspberry Pi, writing Python automation scripts against ALSA drivers for automated 24-bit/48kHz playback testing across 100+ AI voice samples.",
    ],
  },
  {
    org: "Columbia Billinge Group",
    role: "Undergraduate Research Assistant",
    dates: "May 2025 – Dec 2025",
    bullets: [
      "Optimized algorithmic compute bottlenecks within open-source scientific computing packages (diffpy.pdfgetx, diffpy.xpdfsuite), achieving a 40% reduction in data processing latency via vectorization and improved memory management.",
      "Designed and maintained an automated CI/CD pipeline using GitHub Actions and pre-commit automation across 5+ distributed packages, sustaining 90%+ pytest coverage.",
    ],
  },
  {
    org: "Save Away",
    role: "Software Engineering Intern",
    dates: "Jul 2025 – Aug 2025",
    bullets: [
      "Deployed backend recommendation services in Java Spring and Elasticsearch, reducing search query latency by 25% through indexing optimization.",
      "Integrated Stripe and PayPal REST APIs, reducing transaction errors by 15%.",
    ],
  },
];

const filters = [
  { label: "All", value: "all" },
  { label: "Embedded", value: "embedded" },
  { label: "Software", value: "software" },
];
---

<BaseLayout
  title="Zhi Ming Xu | Portfolio"
  description="Computer Engineering student at Columbia University working across embedded systems, backend infrastructure, and applied AI."
>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="mx-auto max-w-[1120px] px-6 pt-20 pb-20 sm:pt-28 sm:pb-28 grid gap-12 lg:grid-cols-[1.15fr_1fr] lg:items-center">
      <div>
        <p class="reveal font-mono text-xs tracking-widest uppercase text-accent mb-4">Computer Engineering · Columbia University</p>
        <h1 class="reveal font-display font-bold tracking-tight leading-[0.95] text-[clamp(3rem,8vw,5.5rem)]">
          Zhi Ming Xu
        </h1>
        <p class="reveal reveal-delay-1 mt-6 text-xl sm:text-2xl text-text max-w-xl">
          Computer Engineering student working at the intersection of hardware, software, and AI.
        </p>
        <p class="reveal reveal-delay-1 mt-4 text-text-secondary max-w-lg">
          Currently looking for internship opportunities with teams doing ambitious engineering work across that stack.
        </p>
        <div class="reveal reveal-delay-2 mt-8 flex flex-wrap gap-4">
          <a href={`${base}#projects`} class="rounded-md bg-accent px-5 py-2.5 font-medium text-bg hover:opacity-90 transition-opacity">
            View Projects
          </a>
          <a href={`${base}#contact`} class="rounded-md border border-border px-5 py-2.5 font-medium hover:border-accent hover:text-accent transition-colors">
            Contact Me
          </a>
        </div>
      </div>
      <div class="reveal reveal-delay-2">
        <OscilloscopeTrace />
      </div>
    </div>
  </section>

  <!-- About -->
  <section id="about">
    <TraceDivider />
    <div class="reveal mx-auto max-w-[1120px] px-6 py-16 grid gap-10 sm:grid-cols-[200px_1fr] items-start">
      <img
        src={`${base}images/headshot.jpg`}
        alt="Headshot of Zhi Ming Xu"
        width="200"
        height="200"
        class="rounded-lg object-cover w-40 h-40 sm:w-[200px] sm:h-[200px]"
      />
      <div class="rounded-lg border border-border bg-surface-raised p-6">
        <div class="flex items-center gap-2 mb-4">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-accent opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-accent"></span>
          </span>
          <span class="font-mono text-xs uppercase tracking-wide text-accent">Status: open to internships</span>
        </div>
        <h2 class="font-display text-2xl font-semibold mb-4">About Me</h2>
        <p class="text-text-secondary max-w-2xl leading-relaxed">
          I'm a Computer Engineering student at Columbia University with experience across embedded systems,
          backend infrastructure, and applied AI. I'm drawn to problems that cut across layers of the stack
          rather than staying in one lane, and I'm looking for internship opportunities with teams doing
          ambitious engineering work at that intersection — including backend and cloud infrastructure more broadly.
        </p>
      </div>
    </div>
  </section>

  <!-- Projects -->
  <section id="projects">
    <TraceDivider />
    <div class="reveal mx-auto max-w-[1120px] px-6 py-16">
      <h2 class="font-display text-2xl font-semibold mb-2">Projects</h2>
      <p class="text-text-secondary mb-8">Selected work spanning embedded systems and software.</p>

      <div class="flex flex-wrap gap-2 mb-8">
        {filters.map((f, i) => (
          <button
            type="button"
            data-filter={f.value}
            class:list={[
              "rounded-md border px-4 py-1.5 text-sm font-medium transition-colors cursor-pointer",
              i === 0 ? "bg-accent border-accent text-bg" : "border-border text-text-secondary hover:border-accent hover:text-accent",
            ]}
          >
            {f.label}
          </button>
        ))}
      </div>

      <div id="project-grid" class="grid gap-6 sm:grid-cols-2">
        {projects.map((project) => <ProjectCard project={project} />)}
      </div>
    </div>
  </section>

  <!-- Skills -->
  <section id="skills">
    <TraceDivider />
    <div class="reveal mx-auto max-w-[1120px] px-6 py-16">
      <h2 class="font-display text-2xl font-semibold mb-8">Skills</h2>
      <div class="grid gap-8 sm:grid-cols-3">
        {skillGroups.map((group, i) => {
          const barColor = i % 2 === 0 ? "border-accent" : "border-indicator";
          const markColor = i % 2 === 0 ? "text-accent" : "text-indicator";
          return (
            <div class={`border-l-2 ${barColor} pl-4`}>
              <h3 class="font-display text-sm font-semibold uppercase tracking-wide text-text-secondary mb-3">
                {group.title}
              </h3>
              <ul class="flex flex-col gap-1.5">
                {group.items.map((item) => (
                  <li class="font-mono text-sm">
                    <span class={markColor}>&gt; </span>
                    <span class="text-text-secondary">{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Experience -->
  <section id="experience">
    <TraceDivider />
    <div class="reveal mx-auto max-w-[1120px] px-6 py-16">
      <h2 class="font-display text-2xl font-semibold mb-8">Experience & Research</h2>
      <div class="relative pl-8">
        <div class="absolute left-[6px] top-2 bottom-2 w-px bg-border"></div>
        <div class="flex flex-col gap-10">
          {experience.map((job, i) => (
            <div class="relative">
              <span
                class:list={[
                  "absolute -left-[26px] top-1.5 w-3.5 h-3.5 rounded-full border-2 bg-bg",
                  i % 2 === 0 ? "border-accent" : "border-indicator",
                ]}
              ></span>
              <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1 mb-2">
                <h3 class="font-display text-lg font-semibold">
                  {job.role} <span class="text-text-secondary font-normal">· {job.org}</span>
                </h3>
                <span class="font-mono text-xs text-text-secondary tabular-nums shrink-0">{job.dates}</span>
              </div>
              <ul class="list-disc pl-4 flex flex-col gap-2 text-text-secondary text-sm leading-relaxed">
                {job.bullets.map((bullet) => <li>{bullet}</li>)}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <script src="../scripts/nav-filter.ts"></script>
  <script src="../scripts/card-preview.ts"></script>
</BaseLayout>
